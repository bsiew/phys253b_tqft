+\begingroup
+\small
+\renewcommand{\arraystretch}{1.3}
+\begin{center}
+\begin{tabular}{@{}p{0.27\linewidth}p{0.27\linewidth}p{0.27\linewidth}@{}}
+\hline
+Fabry--Perot FQH island &
+Graphene interferometer &
+Superconducting qubit array \\
+\hline
+\begin{center}
+\fbox{\begin{minipage}{0.90\linewidth}
+\centering
+edge path\\[0.3em]
+QPC $\rightarrow$ island $\rightarrow$ QPC\\[0.3em]
+braiding phase
+\end{minipage}}
+\end{center}
+&
+\begin{center}
+\fbox{\begin{minipage}{0.90\linewidth}
+\centering
+graphene edge\\[0.3em]
+gate-defined constrictions\\[0.3em]
+visibility window
+\end{minipage}}
+\end{center}
+&
+\begin{center}
+\fbox{\begin{minipage}{0.90\linewidth}
+\centering
+qubit lattice\\[0.3em]
+engineered plaquettes\\[0.3em]
+synthetic anyons
+\end{minipage}}
+\end{center}
+\\
+\hline
+Nakamura et al.: natural fractional quasiparticles and interference phase. &
+Werkmeister et al.: cleaner tunability in a graphene platform. &
+Andersen et al.: programmable simulation of topological excitations. \\
+\hline
+\end{tabular}
+
+\vspace{0.6em}
+\fbox{\begin{minipage}{0.82\linewidth}
+\centering
+Composite schematic for comparing natural interferometry, improved mesoscopic
+device control, and synthetic-platform emulation.
+\end{minipage}}
+\end{center}
+\endgroup
