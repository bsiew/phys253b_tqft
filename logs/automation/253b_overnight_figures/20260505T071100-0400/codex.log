+\setlength{\fboxsep}{7pt}
+\begin{center}
+\begin{tabular}{@{}c@{\qquad}c@{\qquad}c@{}}
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Positive oriented area
+\[
+e^1\wedge e^2
+\]
+\[
+(e^1,e^2)
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Basis exchange
+\[
+e^2\wedge e^1
+=-\,e^1\wedge e^2
+\]
+\[
+(e^2,e^1)
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
