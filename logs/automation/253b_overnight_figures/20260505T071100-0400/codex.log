+\dim\mathcal{H}_{U(1)_k}(T^2)=k
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Clock
+\[
+U\ket{n}=e^{2\pi i n/k}\ket{n}
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Shift
+\[
+V\ket{n}=\ket{n+1}
+\]
+\[
+UV=e^{2\pi i/k}VU
+\]
+\end{minipage}}
