@@ -0,0 +1,62 @@
+\begingroup
+\small
+\renewcommand{\arraystretch}{1.35}
+\begin{center}
+\begin{tabular}{@{}c@{\qquad}c@{}}
+\fbox{\begin{minipage}{0.38\linewidth}
+\centering
+Cycle data on $T^2$
+\[
+\alpha,\ \beta,\qquad
+\alpha\cdot\beta=1
+\]
+\[
+u=\oint_\alpha A,\qquad
+v=\oint_\beta A
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.38\linewidth}
+\centering
+Holonomy phase space
+\[
+(u,v)\sim(u+2\pi,v)
+\sim(u,v+2\pi)
+\]
+\[
+\Omega=\frac{k}{2\pi}\dd u\wedge\dd v
+\]
+\end{minipage}}
+\end{tabular}
+
+\vspace{0.8em}
+\begin{tabular}{@{}c@{\qquad}c@{\qquad}c@{}}
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Quantization
+\[
+\dim\mathcal{H}_{U(1)_k}(T^2)=k
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Clock
+\[
+U\ket{n}=e^{2\pi i n/k}\ket{n}
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Shift
+\[
+V\ket{n}=\ket{n+1}
+\]
+\[
+UV=e^{2\pi i/k}VU
+\]
+\end{minipage}}
+\end{tabular}
+\end{center}
+\endgroup
