+Basis exchange
+\[
+e^2\wedge e^1
+=-\,e^1\wedge e^2
+\]
+\[
+(e^2,e^1)
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
