+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Clock
+\[
+U\ket{n}=e^{2\pi i n/k}\ket{n}
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Shift
+\[
+V\ket{n}=\ket{n+1}
+\]
+\[
