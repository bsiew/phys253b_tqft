diff --git a/tex_docs/figures/f_defect_taxonomy.tex b/tex_docs/figures/f_defect_taxonomy.tex
new file mode 100644
index 0000000000000000000000000000000000000000..745e34654146a9b7cb8005e30f385902e99d4e9d
--- /dev/null
+++ b/tex_docs/figures/f_defect_taxonomy.tex
@@ -0,0 +1,27 @@
+\begingroup
+\small
+\renewcommand{\arraystretch}{1.35}
+\begin{center}
+\begin{tabular}{@{}p{0.20\linewidth}p{0.27\linewidth}p{0.34\linewidth}@{}}
+\hline
+Category & What is topological & Representative observables \\
+\hline
+Strict TQFT &
+Metric-independent exact theory &
+Wilson-link phases, knot data, Hilbert spaces on closed surfaces \\
+\hline
+Topological term in local QFT &
+Protected response after the gap and IR limit are assumed &
+Hall conductance, edge anomaly coefficient, torus degeneracy \\
+\hline
+Topological sector observable &
+Global sector is topological, but the surrounding theory has local dynamics &
+Instanton number, $\chi_t$, theta dependence, monopole charge \\
+\hline
+Experimental proxy &
+Measurement accesses an effective or model-dependent consequence &
+Interferometer phase shifts, neutron EDM bounds, axion searches, monopole limits \\
+\hline
+\end{tabular}
+\end{center}
+\endgroup
diff --git a/tex_docs/figures/f_flat_moduli.tex b/tex_docs/figures/f_flat_moduli.tex
new file mode 100644
index 0000000000000000000000000000000000000000..7d4fa8b9e920afb03d376d735383d884ff9d0681
--- /dev/null
+++ b/tex_docs/figures/f_flat_moduli.tex
@@ -0,0 +1,49 @@
+\begingroup
+\small
+\renewcommand{\arraystretch}{1.4}
+\begin{center}
+\begin{tabular}{@{}c@{}}
+\fbox{\begin{minipage}{0.58\linewidth}
+\centering
+On-shell Chern--Simons condition
+\[
+F_A=0
+\]
+\end{minipage}}
+\\
+$\Downarrow$
+\\
+\fbox{\begin{minipage}{0.58\linewidth}
+\centering
+Flat connection data are holonomies
+\[
+\rho:\pi_1(\Sigma)\longrightarrow G
+\]
+\end{minipage}}
+\\
+$\Downarrow$
+\\
+\fbox{\begin{minipage}{0.68\linewidth}
+\centering
+Gauge equivalence is simultaneous conjugation
+\[
+\mathcal{M}_{\mathrm{flat}}(\Sigma,G)
+=
+\Hom(\pi_1(\Sigma),G)/G .
+\]
+\end{minipage}}
+\\
+$\Downarrow$
+\\
+\fbox{\begin{minipage}{0.68\linewidth}
+\centering
+Finite global phase-space data
+\[
+(\mathcal{M}_{\mathrm{flat}},\Omega_{\mathrm{CS}})
+\quad\leadsto\quad
+\mathcal{H}(\Sigma)
+\]
+\end{minipage}}
+\end{tabular}
+\end{center}
+\endgroup
diff --git a/tex_docs/figures/f_forms_orientation.tex b/tex_docs/figures/f_forms_orientation.tex
new file mode 100644
index 0000000000000000000000000000000000000000..0cb527089ea7953fc29f049ae68e3326f61f7e94
--- /dev/null
+++ b/tex_docs/figures/f_forms_orientation.tex
@@ -0,0 +1,55 @@
+\begingroup
+\small
+\setlength{\fboxsep}{7pt}
+\begin{center}
+\begin{tabular}{@{}c@{\qquad}c@{\qquad}c@{}}
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Positive oriented area
+\[
+e^1\wedge e^2
+\]
+\[
+(e^1,e^2)
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Basis exchange
+\[
+e^2\wedge e^1
+=-\,e^1\wedge e^2
+\]
+\[
+(e^2,e^1)
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Volume orientation
+\[
+e^1\wedge e^2\wedge e^3
+\]
+\[
+\operatorname{sgn}(\sigma)
+\]
+\end{minipage}}
+\end{tabular}
+
+\vspace{0.6em}
+\begin{tabular}{@{}c@{}}
+\fbox{\begin{minipage}{0.82\linewidth}
+\centering
+Orientation is encoded algebraically:
+\[
+e^{\sigma(1)}\wedge\cdots\wedge e^{\sigma(n)}
+=
+\operatorname{sgn}(\sigma)\,
+e^1\wedge\cdots\wedge e^n .
+\]
+\end{minipage}}
+\end{tabular}
+\end{center}
+\endgroup
diff --git a/tex_docs/figures/f_hall_response.tex b/tex_docs/figures/f_hall_response.tex
new file mode 100644
index 0000000000000000000000000000000000000000..de5f60b404a3faf3f74fd8da609c8689977ffc2f
--- /dev/null
+++ b/tex_docs/figures/f_hall_response.tex
@@ -0,0 +1,42 @@
+\begingroup
+\small
+\renewcommand{\arraystretch}{1.3}
+\begin{center}
+\begin{tabular}{@{}c@{\qquad}c@{\qquad}c@{}}
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Probe field
+\[
+E_x=-\partial_t A_x+\partial_x A_t
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Effective response
+\[
+S_{\mathrm{eff}}[A]
+=\frac{\nu}{4\pi}\int A\wedge\dd A
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Measured current
+\[
+j_y=\frac{\nu}{2\pi}E_x
+\]
+\[
+\sigma_{xy}=\nu\frac{e^2}{h}
+\]
+\end{minipage}}
+\end{tabular}
+
+\vspace{0.8em}
+\fbox{\begin{minipage}{0.78\linewidth}
+\centering
+For a Laughlin state, $\nu=1/m$. The same integer $m$ also fixes
+quasihole charge $e/m$ and exchange angle $\pi/m$.
+\end{minipage}}
+\end{center}
+\endgroup
diff --git a/tex_docs/figures/f_kmatrix_observables.tex b/tex_docs/figures/f_kmatrix_observables.tex
new file mode 100644
index 0000000000000000000000000000000000000000..45aa47f70ce782d501ee2ddb279a7a8764aab5d0
--- /dev/null
+++ b/tex_docs/figures/f_kmatrix_observables.tex
@@ -0,0 +1,44 @@
+\begingroup
+\small
+\renewcommand{\arraystretch}{1.45}
+\begin{center}
+\begin{tabular}{@{}p{0.18\linewidth}p{0.33\linewidth}p{0.33\linewidth}@{}}
+\hline
+Input data & Operation & Observable output \\
+\hline
+$K$, $t$ &
+Invert the integer form &
+\[
+\nu=t^{\mathsf T}K^{-1}t,
+\qquad
+\sigma_{xy}=\nu e^2/h
+\]
+\\
+\hline
+$\ell\in\mathbb{Z}^N$ &
+Pair charge vector with quasiparticle vector &
+\[
+Q_\ell=e\,t^{\mathsf T}K^{-1}\ell
+\]
+\\
+\hline
+$\ell,\ell'$ &
+Pair quasiparticle vectors through $K^{-1}$ &
+\[
+\theta_{\ell\ell'}
+=2\pi\,\ell^{\mathsf T}K^{-1}\ell',
+\qquad
+\theta_\ell=\pi\,\ell^{\mathsf T}K^{-1}\ell
+\]
+\\
+\hline
+$K$ on genus $g$ &
+Count global holonomy sectors &
+\[
+\dim\mathcal{H}(\Sigma_g)=|\det K|^g
+\]
+\\
+\hline
+\end{tabular}
+\end{center}
+\endgroup
