+\Downarrow
+\\
+\fbox{\begin{minipage}{0.62\linewidth}
+\centering
+Axion response
+\[
+m_a^2 f_a^2=\chi_t,
+\qquad
+\bar\theta\rightarrow \bar\theta+a/f_a .
+\]
+\end{minipage}}
+\end{array}
+\]
+\end{center}
+\endgroup
