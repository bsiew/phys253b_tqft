+\begingroup
+\small
+\renewcommand{\arraystretch}{1.35}
+\begin{center}
+\begin{tabular}{@{}c@{}}
+\fbox{\begin{minipage}{0.62\linewidth}
+\centering
+Topological density and theta term
+\[
+q(x)=\frac{g^2}{32\pi^2}\tr(F\tilde F),
+\qquad
+S_\theta=i\theta\int q(x)\,\dd^4x
+\]
+\end{minipage}}
+\\
+$\Downarrow$
+\\
+\fbox{\begin{minipage}{0.62\linewidth}
+\centering
+Vacuum curvature
+\[
+\chi_t=\int \dd^4x\,\langle q(x)q(0)\rangle
+=\left.\frac{\partial^2 E(\theta)}{\partial\theta^2}\right|_{\theta=0}
+\]
+\end{minipage}}
+\\
+$\Downarrow$
+\\
+\fbox{\begin{minipage}{0.62\linewidth}
+\centering
+Hadron spectroscopy and CP tests
+\[
+\eta'\ \mathrm{mass},\qquad
+d_n\ \mathrm{bounds}\ \bar\theta
+\]
+\end{minipage}}
+\\
+$\Downarrow$
+\\
+\fbox{\begin{minipage}{0.62\linewidth}
+\centering
+Axion response
+\[
+m_a^2 f_a^2=\chi_t,
+\qquad
+\bar\theta\rightarrow \bar\theta+a/f_a .
+\]
+\end{minipage}}
+\end{tabular}
+\end{center}
+\endgroup
