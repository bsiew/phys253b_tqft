@@ -0,0 +1,44 @@
+\begingroup
+\small
+\renewcommand{\arraystretch}{1.45}
+\begin{center}
+\begin{tabular}{@{}p{0.18\linewidth}p{0.33\linewidth}p{0.33\linewidth}@{}}
+\hline
+Input data & Operation & Observable output \\
+\hline
+$K$, $t$ &
+Invert the integer form &
+\[
+\nu=t^{\mathsf T}K^{-1}t,
+\qquad
+\sigma_{xy}=\nu e^2/h
+\]
+\\
+\hline
+$\ell\in\mathbb{Z}^N$ &
+Pair charge vector with quasiparticle vector &
+\[
+Q_\ell=e\,t^{\mathsf T}K^{-1}\ell
+\]
+\\
+\hline
+$\ell,\ell'$ &
+Pair quasiparticle vectors through $K^{-1}$ &
+\[
+\theta_{\ell\ell'}
+=2\pi\,\ell^{\mathsf T}K^{-1}\ell',
+\qquad
+\theta_\ell=\pi\,\ell^{\mathsf T}K^{-1}\ell
+\]
+\\
+\hline
+$K$ on genus $g$ &
+Count global holonomy sectors &
+\[
+\dim\mathcal{H}(\Sigma_g)=|\det K|^g
+\]
+\\
+\hline
+\end{tabular}
+\end{center}
+\endgroup
diff --git a/tex_docs/figures/f_response_overview.tex b/tex_docs/figures/f_response_overview.tex
new file mode 100644
index 0000000000000000000000000000000000000000..8380129fe8edecdd16e485abc77005299996dfa1
--- /dev/null
+++ b/tex_docs/figures/f_response_overview.tex
@@ -0,0 +1,77 @@
+\begingroup
+\small
+\renewcommand{\arraystretch}{1.25}
+\begin{center}
+\[
+\begin{array}{ccccc}
+\fbox{\begin{minipage}{0.16\linewidth}\centering
+Bulk CS term
+\[
+\frac{K_{IJ}}{4\pi}a^I\dd a^J
+\]
+\end{minipage}}
+&
+\Longrightarrow
+&
+\fbox{\begin{minipage}{0.18\linewidth}\centering
+Hall response
+\[
+\sigma_{xy}
+=\frac{e^2}{h}t^TK^{-1}t
+\]
+\end{minipage}}
+&
+\Longrightarrow
+&
+\fbox{\begin{minipage}{0.16\linewidth}\centering
+Transport plateau
+\[
+\nu=t^TK^{-1}t
+\]
+\end{minipage}}
+\\[1.2em]
+&&
+\fbox{\begin{minipage}{0.18\linewidth}\centering
+Quasiparticles
+\[
+\ell,\quad Q_\ell=e\,t^TK^{-1}\ell
+\]
+\end{minipage}}
+&&
+\fbox{\begin{minipage}{0.16\linewidth}\centering
+Braiding
+\[
+\theta_{\ell\ell'}
+=2\pi\ell^TK^{-1}\ell'
+\]
+\end{minipage}}
+\\[1.2em]
+\fbox{\begin{minipage}{0.16\linewidth}\centering
+Boundary variation
+\[
+\delta S_{\mathrm{bulk}}
+\]
+\end{minipage}}
+&
+\Longleftrightarrow
+&
+\fbox{\begin{minipage}{0.18\linewidth}\centering
+Edge anomaly
+\[
+\delta S_{\partial}
+=-\delta S_{\mathrm{bulk}}
+\]
+\end{minipage}}
+&
+\Longleftrightarrow
+&
+\fbox{\begin{minipage}{0.16\linewidth}\centering
+Torus sectors
+\[
+\dim\mathcal{H}_{T^2}=|\det K|
+\]
+\end{minipage}}
+\end{array}
+\]
+\end{center}
+\endgroup
diff --git a/tex_docs/figures/f_su2_winding.tex b/tex_docs/figures/f_su2_winding.tex
new file mode 100644
index 0000000000000000000000000000000000000000..48af4408cf7a87fcbef48b0b302e3dab2fb4cb50
--- /dev/null
+++ b/tex_docs/figures/f_su2_winding.tex
@@ -0,0 +1,49 @@
+\begingroup
+\small
+\renewcommand{\arraystretch}{1.35}
+\begin{center}
+\begin{tabular}{@{}p{0.28\linewidth}p{0.55\linewidth}@{}}
+\hline
+Geometry &
+\[
+\SU(2)\cong S^3,\qquad
+g(\chi,\theta,\phi)
+=\cos\chi\,\mathbf{1}
+i\sin\chi\,\hat n(\theta,\phi)\cdot\vec\sigma
+\]
+\\
+\hline
+Coordinate ranges &
+\[
+0\leq\chi\leq\pi,\qquad
+0\leq\theta\leq\pi,\qquad
+0\leq\phi<2\pi .
+\]
+\\
+\hline
+Normalized winding density &
+\[
+\nu(g)=
+\frac{1}{24\pi^2}\tr(g^{-1}\dd g)^3 .
+\]
+\\
+\hline
+Level-quantization input &
+\[
+\int_{\SU(2)}\tr(g^{-1}\dd g)^3=24\pi^2,
+\qquad
+\int_{\SU(2)}\nu(g)=1 .
+\]
+\\
+\hline
+\end{tabular}
+
+\vspace{0.8em}
+\fbox{\begin{minipage}{0.78\linewidth}
+\centering
+A large gauge transformation of winding $n$ shifts the Chern--Simons action
+by $2\pi k n$. Gauge invariance of $\exp(iS)$ therefore requires
+$k\in\mathbb{Z}$.
+\end{minipage}}
+\end{center}
+\endgroup
diff --git a/tex_docs/figures/f_theta_observable_chain.tex b/tex_docs/figures/f_theta_observable_chain.tex
new file mode 100644
index 0000000000000000000000000000000000000000..66004cfe61e88d13f3d2854c7909ac72ab55830d
--- /dev/null
+++ b/tex_docs/figures/f_theta_observable_chain.tex
@@ -0,0 +1,53 @@
+\begingroup
+\small
+\renewcommand{\arraystretch}{1.35}
+\begin{center}
+\[
+\begin{array}{c}
+\fbox{\begin{minipage}{0.62\linewidth}
+\centering
+Topological density and theta term
+\[
+q(x)=\frac{g^2}{32\pi^2}\tr(F\tilde F),
+\qquad
+S_\theta=i\theta\int q(x)\,\dd^4x
+\]
+\end{minipage}}
+\\
+\Downarrow
+\\
+\fbox{\begin{minipage}{0.62\linewidth}
+\centering
+Vacuum curvature
+\[
+\chi_t=\int \dd^4x\,\langle q(x)q(0)\rangle
+=\left.\frac{\partial^2 E(\theta)}{\partial\theta^2}\right|_{\theta=0}
+\]
+\end{minipage}}
+\\
+\Downarrow
+\\
+\fbox{\begin{minipage}{0.62\linewidth}
+\centering
+Hadron spectroscopy and CP tests
+\[
+\eta'\ \mathrm{mass},\qquad
+d_n\ \mathrm{bounds}\ \bar\theta
+\]
+\end{minipage}}
+\\
+\Downarrow
+\\
+\fbox{\begin{minipage}{0.62\linewidth}
+\centering
+Axion response
+\[
+m_a^2 f_a^2=\chi_t,
+\qquad
+\bar\theta\rightarrow \bar\theta+a/f_a .
+\]
+\end{minipage}}
+\end{array}
+\]
+\end{center}
+\endgroup
diff --git a/tex_docs/figures/f_torus_holonomies.tex b/tex_docs/figures/f_torus_holonomies.tex
new file mode 100644
index 0000000000000000000000000000000000000000..11bdaab210658aec23e657ddd9c80bed454bfdfd
--- /dev/null
+++ b/tex_docs/figures/f_torus_holonomies.tex
@@ -0,0 +1,62 @@
+\begingroup
+\small
+\renewcommand{\arraystretch}{1.35}
+\begin{center}
+\begin{tabular}{@{}c@{\qquad}c@{}}
+\fbox{\begin{minipage}{0.38\linewidth}
+\centering
+Cycle data on $T^2$
+\[
+\alpha,\ \beta,\qquad
+\alpha\cdot\beta=1
+\]
+\[
+u=\oint_\alpha A,\qquad
+v=\oint_\beta A
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.38\linewidth}
+\centering
+Holonomy phase space
+\[
+(u,v)\sim(u+2\pi,v)
+\sim(u,v+2\pi)
+\]
+\[
+\Omega=\frac{k}{2\pi}\dd u\wedge\dd v
+\]
+\end{minipage}}
+\end{tabular}
+
+\vspace{0.8em}
+\begin{tabular}{@{}c@{\qquad}c@{\qquad}c@{}}
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Quantization
+\[
+\dim\mathcal{H}_{U(1)_k}(T^2)=k
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Clock
+\[
+U\ket{n}=e^{2\pi i n/k}\ket{n}
+\]
+\end{minipage}}
+&
+\fbox{\begin{minipage}{0.24\linewidth}
+\centering
+Shift
+\[
+V\ket{n}=\ket{n+1}
+\]
+\[
+UV=e^{2\pi i/k}VU
+\]
+\end{minipage}}
+\end{tabular}
+\end{center}
+\endgroup
diff --git a/tex_docs/figures/f_transgression_ladder.tex b/tex_docs/figures/f_transgression_ladder.tex
new file mode 100644
index 0000000000000000000000000000000000000000..d2f8a66fc90984fa8f947c534bd6f303014109da
--- /dev/null
+++ b/tex_docs/figures/f_transgression_ladder.tex
@@ -0,0 +1,52 @@
+\begingroup
+\small
+\renewcommand{\arraystretch}{1.35}
+\begin{center}
+\[
+\begin{array}{c}
+\fbox{\begin{minipage}{0.62\linewidth}
+\centering
+Four-dimensional characteristic density
+\[
+\tr(F\wedge F)
+\]
+\end{minipage}}
+\\[-0.1em]
+\Downarrow\quad \dd\omega_{\mathrm{CS}}(A)=\tr(F\wedge F)
+\\[-0.1em]
+\fbox{\begin{minipage}{0.62\linewidth}
+\centering
+Three-dimensional transgression form
+\[
+\omega_{\mathrm{CS}}(A)
+=
+\tr\!\left(A\wedge\dd A+\frac{2}{3}A\wedge A\wedge A\right)
+\]
+\end{minipage}}
+\\[-0.1em]
+\Downarrow\quad A\mapsto A^g
+\\[-0.1em]
+\fbox{\begin{minipage}{0.70\linewidth}
+\centering
+Gauge transform separates into an exact term and a winding term
+\[
+\omega_{\mathrm{CS}}(A^g)-\omega_{\mathrm{CS}}(A)
+=\dd(\cdots)+\frac{1}{3}\tr(g^{-1}\dd g)^3 .
+\]
+\end{minipage}}
+\\[-0.1em]
+\Downarrow
+\\[-0.1em]
+\fbox{\begin{minipage}{0.70\linewidth}
+\centering
+Boundary/anomaly bookkeeping
+\[
+\int_M \dd(\cdots)=\int_{\partial M}(\cdots),
+\qquad
+\int \tr(g^{-1}\dd g)^3 \in 24\pi^2\mathbb{Z}.
+\]
+\end{minipage}}
+\end{array}
+\]
+\end{center}
+\endgroup
