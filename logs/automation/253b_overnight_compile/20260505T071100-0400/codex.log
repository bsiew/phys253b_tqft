#!/bin/zsh

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 path/to/file.tex" >&2
  exit 1
fi

source_tex="$1"

if [[ ! -f "$source_tex" ]]; then
  echo "TeX source not found: $source_tex" >&2
  exit 1
fi

script_dir="$(cd "$(dirname "$0")" && pwd)"
project_root="$(cd "$script_dir/.." && pwd)"
artifact_root="$project_root/artifacts/tex_compile"
source_abs="$(cd "$(dirname "$source_tex")" && pwd)/$(basename "$source_tex")"
source_dir="$(cd "$(dirname "$source_abs")" && pwd)"
source_file="$(basename "$source_abs")"
build_name="${${source_tex:t}%.*}"
build_dir="$artifact_root/$build_name"

mkdir -p "$build_dir"

(
  cd "$source_dir"
  latexmk \
    -pdf \
    -interaction=nonstopmode \
    -halt-on-error \
    -file-line-error \
    -outdir="$build_dir" \
    "$source_file"
)

echo "Built $build_dir/$build_name.pdf"

