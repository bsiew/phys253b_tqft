codex
The repeated Perl parse failure is just quoting noise from cramming the script into one line. I’m switching to a here-doc Perl script inside bash so the extraction logic is explicit and stable.
exec
/bin/zsh -lc 'tmpfile=$(mktemp /private/tmp/qft_extract.XXXXXX.md)
title=$(perl -0ne '"'if (/\\\\title\\{(.*?)\\}/s) { "'$t = $1; $t =~ s/'"\\s+/ /g; print "'$t; }'"' revised2.tex)
{
  sed -n '1,/"'^# Scientific TeX Extract$/p'"' codex_scientific_text.md
  printf '\\n## %s\\n\\n' \""'$title"
  perl -0 revised2.tex <<'"'PERL'
local "'$/;
$_ = <>;
s/.*?'"\\\\begin\\{abstract\\}\\s*/**Abstract.** /s;
s/\\s*\\\\end\\{abstract\\}\\s*/\\n\\n/s;
s/\\\\pacs\\{.*?\\}\\s*\\\\maketitle\\s*//s;
s/\\\\begin\\{thebibliography\\}.*?\\\\end\\{thebibliography\\}//sg;
s/\\\\end\\{document\\}.*/ /s;
s/(?<"'!'"\\\\)%.*"'$//mg;
s/'"\\\\begin\\{figure\\*?\\}.*?\\\\end\\{figure\\*?\\}\\s*//sg;
s/\\\\begin\\{equation\\}/\\n"'$$'"\\n/g;
s/\\\\end\\{equation\\}/\\n"'$$'"\\n/g;
s/\\\\label\\{["'^}]+'"\\}//g;
s/\\\\onlinecite\\{(["'^}]*)'"\\}/[Ref: "'$1]/g;
s/'"\\\\cite\\{(["'^}]*)'"\\}/[Refs: "'$1]/g;
s/'"\\\\eqref\\{(["'^}]*)'"\\}/("'$1)/g;
s/'"\\\\ref\\{(["'^}]*)'"\\}/"'$1/g;
s/'"\\{\\\\it\\s+(["'^}]*)'"\\}/*"'$1*/g;
s/'"\\\\emph\\{(["'^}]*)'"\\}/*"'$1*/g;
s/We thank Sankar das Sarma and Steve Simon for'"\\s+helpful discussions\\.\\s+This work was supported by NSF grant\\s+DMR-0605066, and by ACS PRF grant 44776-AC10\\.\\s*//s;
s/[ \\t]+\\n/\\n/g;
s/\\n{3,}/\\n\\n/g;
s/"'^'"\\s+//;
s/\\s+"'$//;
print;
PERL
} > "$tmpfile"
